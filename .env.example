# docker compose 使用的配置。复制为 .env 并替换所有值（可用 openssl rand -hex 32 生成）。
POSTGRES_PASSWORD=change-me
MEILI_MASTER_KEY=change-me-at-least-16-bytes
JWT_SECRET=change-me-to-a-long-random-string
# 还没配置 HTTPS 时设为 false，否则浏览器不会在 HTTP 下保存登录 Cookie
COOKIE_SECURE=true

# 备份脚本 deploy/backup.sh 使用（需要先安装并配置 ossutil）
OSS_BACKUP_URI=oss://your-bucket/ai-images-backup
