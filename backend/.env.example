# 复制为 .env 后按需修改（生产环境务必更换所有密钥）
ATLAS_ENV=development
ATLAS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_images
ATLAS_MEILI_URL=http://127.0.0.1:7700
ATLAS_MEILI_MASTER_KEY=change-me-at-least-16-bytes
ATLAS_JWT_SECRET=change-me-to-a-long-random-string
# ATLAS_MEDIA_ROOT=/data/media
# ATLAS_RESOURCES_DIR=/app/resources/image-inspirer
# ATLAS_COOKIE_SECURE=true
